# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for the LLM tutor;
# everything else has working defaults.

# Required for /tutor/explain endpoint. Without it, the tutor button is disabled
# in the UI (frontend reads /tutor/status to decide).
ANTHROPIC_API_KEY=

# Optional overrides
# TUTOR_MODEL=claude-sonnet-4-6
# TUTOR_MAX_TOKENS=350
